{
  "name": "umbraco-connector",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "node --watch --env-file=backend/.env backend/src/index.ts",
    "start:backend": "node --env-file=backend/.env backend/src/index.ts",
    "typecheck:backend": "tsc -p backend",
    "test": "vitest --root backend",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write backend/src backend/tests eslint.config.js",
    "format:check": "prettier --check backend/src backend/tests eslint.config.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "sanitize-html": "^2.18.2",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "office-addin-dev-certs": "^3.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
